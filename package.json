{
  "name": "biosphere",
  "version": "1.0.0",
  "private": true,
  "description": "BioSphere — a deterministic living-planet simulator, from genome to ecosystem.",
  "license": "MIT",
  "homepage": "https://github.com/shivang-jindal/BioSphere#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivang-jindal/BioSphere.git"
  },
  "bugs": {
    "url": "https://github.com/shivang-jindal/BioSphere/issues"
  },
  "keywords": [
    "biodiversity",
    "conservation",
    "ecology",
    "digital-twin",
    "deterministic",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build:shared": "npm run build -w @biosphere/shared",
    "build:server": "npm run build -w @biosphere/server",
    "build:client": "npm run build -w @biosphere/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "typecheck": "npm run build:shared && npm run typecheck -w @biosphere/server && npm run typecheck -w @biosphere/client",
    "lint": "eslint .",
    "test": "npm run build:shared && vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run dev -w @biosphere/server",
    "dev:client": "npm run dev -w @biosphere/client",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start -w @biosphere/server",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.3.4",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
